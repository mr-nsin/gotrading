  });
}

export function useSquareOffPosition() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: api.squareOffPosition,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['positions'] });
      queryClient.invalidateQueries({ queryKey: ['dashboard'] });
    },
